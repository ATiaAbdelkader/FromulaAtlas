# Formula Atlas — Environment Variables
# Copy this file to .env.local and fill in the values you need.
# All services have FREE tiers — no credit card required.

# ============================================================================
# REQUIRED (already configured — no key needed)
# ============================================================================

# Open-Meteo Weather API (free, no key, 10K calls/day)
# Used by: ET Tracker, Weather Radar, GDD Tracker, Elevation, Weather Alert Banner
# No configuration needed — client-side fetch to api.open-meteo.com

# z-ai-web-dev-sdk (AI chat — included in environment)
# Used by: AI Specialists, Season Plan Generator, Smart Agriculture Suite
# No configuration needed when the deployment provides its z-ai configuration.

# Optional OpenAI-compatible fallback for local/Vercel deployments without z-ai config.
# The Agronomist route prefers these variables when both are present.
OPENAI_API_BASE=
OPENAI_API_KEY=
FORMULA_ATLAS_LLM_MODEL=gpt-5-mini

# ============================================================================
# OPTIONAL — User Authentication
# ============================================================================

# Clerk (free: 50,000 monthly active users)
# Get keys: https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ============================================================================
# OPTIONAL — Cloud Database
# ============================================================================

# Neon Postgres (free: 0.5 GB, 100 projects)
# Get connection string: https://neon.tech
DATABASE_URL=

# Supabase (free: 500 MB DB + 50K MAU auth + 1 GB storage)
# Alternative to Clerk + Neon combined
NEXT_PUBLIC_SUPABASE_URL=

# ============================================================================
# OPTIONAL — Push Notifications
# ============================================================================

# OneSignal (free: unlimited push + 10K emails/month)
# Get App ID: https://onesignal.com
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# ============================================================================
# OPTIONAL — Map Tiles
# ============================================================================

# MapTiler (free: 100K tile loads/month, 4 styles)
# Get key: https://www.maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=

# ============================================================================
# OPTIONAL — AI Vision (pest/disease photo analysis)
# ============================================================================

# Google Gemini API (free: 15 req/min, 1,500 req/day)
# Get key: https://ai.google.dev
GOOGLE_GEMINI_API_KEY=

# ============================================================================
# OPTIONAL — Error Tracking
# ============================================================================

# Sentry (free: 5K errors/month)
# Get DSN: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================================
# OPTIONAL — Telegram Bot (notifications)
# ============================================================================

TELEGRAM_BOT_TOKEN=

# ============================================================================
# Notes
# ============================================================================
# 1. The app works WITHOUT any of these keys — all core features use
#    free, no-key services (Open-Meteo + z-ai-web-dev-sdk).
# 2. Optional integrations are scaffolded in the Service Integrations panel
#    (Insights tab → Settings & Integrations). Enter keys there or in .env.local.
# 3. For Vercel deployment: add environment variables in Vercel project settings.
# 4. For Docker: re-add `output: "standalone"` to next.config.ts and use a Dockerfile.
