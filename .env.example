# Formula Atlas — Environment Variables
# Copy this file to .env.local and fill in the values you need.
# All services have FREE tiers — no credit card required.

# ============================================================================
# REQUIRED (already configured — no key needed)
# ============================================================================

# Open-Meteo Weather API (free, no key, 10K calls/day)
# Used by: ET Tracker, Weather Radar, GDD Tracker, Elevation, Weather Alert Banner
# No configuration needed — client-side fetch to api.open-meteo.com

# z-ai-web-dev-sdk (AI chat — included in environment)
# Used by: AI Specialists, Season Plan Generator, Smart Agriculture Suite
# No configuration needed when the deployment provides its z-ai configuration.

# Optional OpenAI-compatible fallback for local/Vercel deployments without z-ai config.
# The Agronomist route prefers these variables when both are present.
OPENAI_API_BASE=
OPENAI_API_KEY=
FORMULA_ATLAS_LLM_MODEL=gpt-5-mini

# ============================================================================
# OPTIONAL — User Authentication
# ============================================================================

# Clerk (free: 50,000 monthly active users)
# Get keys: https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ============================================================================
# OPTIONAL — Cloud Database
# ============================================================================

# Neon Postgres (free: 0.5 GB, 100 projects)
# Get connection string: https://neon.tech
DATABASE_URL=

# Supabase (free: 500 MB DB + 50K MAU auth + 1 GB storage)
# Alternative to Clerk + Neon combined
NEXT_PUBLIC_SUPABASE_URL=

# ============================================================================
# OPTIONAL — Push Notifications
# ============================================================================

# OneSignal (free: unlimited push + 10K emails/month)
# Get App ID & REST API Key: https://onesignal.com
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ============================================================================
# OPTIONAL — Map Tiles
# ============================================================================

# MapTiler (free: 100K tile loads/month, 4 styles)
# Get key: https://www.maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=

# ============================================================================
# OPTIONAL — AI Vision (pest/disease photo analysis)
# ============================================================================

# Google Gemini API (server-side smart planning, vision, agronomic intelligence)
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# ============================================================================
# OPTIONAL — Error Tracking
# ============================================================================

# Sentry (free: 5K errors/month)
# Get DSN: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================================
# OPTIONAL — Telegram Bot (notifications)
# ============================================================================

TELEGRAM_BOT_TOKEN=

# ============================================================================
# Notes
# ============================================================================
# 1. The app works WITHOUT any of these keys — all core features use
#    free, no-key services (Open-Meteo + z-ai-web-dev-sdk).
# 2. Optional integrations are scaffolded in the Service Integrations panel
#    (Insights tab → Settings & Integrations). Enter keys there or in .env.local.
# 3. For Vercel deployment: add environment variables in Vercel project settings.
# 4. For Docker: re-add `output: "standalone"` to next.config.ts and use a Dockerfile.

# ============================================================================
# OPTIONAL — WhatsApp Daily Brief (Foundation mode: stub, zero cost)
# ============================================================================
# WHATSAPP_SEND_MODE controls whether briefs are actually sent or just logged:
#   - stub  (default): briefs are computed + logged to BriefLog table, but
#                      NOT sent via WhatsApp. Zero cost. Use this until you
#                      have a Meta Business Account + funding.
#   - live         : briefs are sent via WhatsApp Business Cloud API.
#                      Requires WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID.
#
# To switch from stub to live when funding arrives:
#   1. Create Meta Business Account + register WhatsApp Business number
#   2. Submit 4 message templates for review (see WHATSAPP-OUTBOUND-SCOPE.md §6)
#   3. Get WHATSAPP_ACCESS_TOKEN (system user token) + WHATSAPP_PHONE_NUMBER_ID
#   4. Set these 3 env vars in Vercel + redeploy — no code changes needed.
WHATSAPP_SEND_MODE=stub
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Required for the inbound webhook (Phase 5):
# - WHATSAPP_APP_SECRET: from Meta App Dashboard → App Settings → Basic → App Secret.
#   Used to verify X-Hub-Signature-256 on webhook POST requests (prevents spoofing).
# - WHATSAPP_WEBHOOK_VERIFY_TOKEN: any string you choose (e.g. `openssl rand -hex 16`).
#   Set the SAME value in Meta Business Manager when configuring the webhook URL.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Public base URL of your deployment — used to build unsubscribe links in briefs.
# Example: https://formulaatlas.dz  (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://formulaatlas.dz

# Secret used to protect the /api/cron/daily-brief endpoint from public access.
# Generate a random string (e.g. `openssl rand -hex 32`) and set it both here
# and in the Vercel cron job config as the x-cron-secret header.
CRON_SECRET=

# ============================================================================
# Foundation mode summary
# ============================================================================
# With WHATSAPP_SEND_MODE=stub (default), the app:
#   - Accepts phone-based subscriptions (consent flow works)
#   - Computes briefs daily at 05:30 UTC via Vercel Cron
#   - Logs every brief to the BriefLog table (status=PENDING, mode=STUB)
#   - Does NOT send any WhatsApp messages
#   - Costs $0/month on Vercel Hobby + Vercel Postgres free tier
#
# When you flip WHATSAPP_SEND_MODE=live, the same code starts sending real
# WhatsApp messages via the Meta Graph API. No migration, no code changes.

# ============================================================================
# OPTIONAL — Chargily payment integration (CIB + Edahabia)
# ============================================================================
# Chargily is the standard Algerian payment gateway. Supports CIB, Edahabia,
# and BaridiMob. No monthly fee, ~2% per transaction.
#
# Get your keys at: https://epay.chargily.com/ (create account → API keys)
#
# Foundation mode: if CHARGILY_SECRET_KEY is not set, checkout returns a stub
# URL (/payment-pending) explaining payment is not yet live. Subscriptions
# are still recorded in the ProSubscription table with status=PENDING.
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=

# ============================================================================
# OPTIONAL — Admin dashboard
# ============================================================================
# Secret required to access /admin (BriefLog metrics dashboard).
# Generate: openssl rand -hex 32
# Enter this secret in the /admin login prompt.
ADMIN_SECRET=

# ============================================================================
# OPTIONAL — Telemetry (PostHog)
# ============================================================================
# PostHog is open-source product analytics. Free tier: 1M events/month,
# 5-year data retention. Get your key at https://posthog.com (cloud) or
# self-host.
#
# Foundation mode: if NEXT_PUBLIC_POSTHOG_KEY is not set, all telemetry
# functions are no-ops (no network calls, no events tracked). The app
# works identically — just without analytics.
#
# Privacy:
#   - Respects Do Not Track (navigator.doNotTrack)
#   - No IP capture (ip: false)
#   - Uses localStorage (not cookies) — no consent banner needed yet
#   - Upgrade to cookie-based + consent banner when required by law
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
