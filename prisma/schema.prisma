// This is the Prisma schema file for FormulaAtlas.
//
// Provider: postgresql
//   - Production: Vercel Postgres (free tier — 256MB, sufficient for ~10K farmers)
//   - Local dev:  either install Postgres locally OR point DATABASE_URL at
//                 Vercel Postgres (works fine, just slightly higher latency)
//
// We previously used SQLite, but it locks under concurrent writes (cron job +
// user requests collide). Postgres is required for the WhatsApp outbound
// pipeline (see WHATSAPP-OUTBOUND-SCOPE.md §0).
//
// Migrating from SQLite to Postgres:
//   1. Create a Vercel Postgres database in your Vercel dashboard
//   2. Copy the connection string (looks like postgres://user:pass@host:5432/db)
//   3. Set DATABASE_URL in your .env (local) and Vercel project env vars
//   4. Run: npm run db:push   (creates tables, no data migration needed —
//      the old SQLite data was dev-only seed/test data)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Legacy demo models (kept for the existing /app/api/* routes that use them;
// will be removed once those routes are migrated to use Farmer)
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Farmer identity (Foundation mode — see WHATSAPP-OUTBOUND-SCOPE.md §0)
//
// A Farmer is identified by their WhatsApp phone number in E.164 format
// (e.g. "+213661234567"). No email — most Algerian farmers don't have one.
//
// `phoneVerified` is false until the farmer completes WhatsApp OTP (which
// requires the WhatsApp Business API to be live — deferred until funding).
// In Foundation mode, we validate phone format only and mark as unverified.
// ---------------------------------------------------------------------------

model Farmer {
  id            String         @id @default(cuid())
  phoneE164     String         @unique
  displayName   String?
  language      Language       @default(AR)
  phoneVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?

  subscription  Subscription?
  briefLogs     BriefLog[]
  farmProfile   FarmProfile?
  proSubscription ProSubscription?

  @@index([phoneE164])
}

// ---------------------------------------------------------------------------
// FarmProfile (server-side snapshot)
//
// Mirrors the localStorage `farm_profile_v1` shape, persisted to Postgres
// so the cron job can read it without access to the farmer's browser.
//
// Synced lazily: when a logged-in farmer saves their farm profile in the
// UI, the existing localStorage write fires AND a background POST
// /api/farm-profile upserts this row.
//
// If the farmer has no profile, the cron skips them with BriefLog
// status=SKIPPED + reason="no_farm_profile".
// ---------------------------------------------------------------------------

model FarmProfile {
  id              String   @id @default(cuid())
  farmerId        String   @unique
  farmer          Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name            String?
  lat             Float?
  lng             Float?
  crop            String?  // canonical crop id (e.g. 'potato', 'wheat')
  plantingDate    String?  // ISO YYYY-MM-DD
  areaHa          Float?
  // Snapshot of FarmPilotPlan (irrigation system, fertilizer, target yield)
  planJson        String?  // JSON.stringify(FarmPilotPlan)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([farmerId])
}

// ---------------------------------------------------------------------------
// Subscription — opt-in to the daily WhatsApp brief
//
// One subscription per farmer for v1. v2 can add multiple (e.g., one per
// field, or different brief types).
//
// Consent is recorded with timestamp + IP + privacy policy version, per
// Algerian data protection law (18-07, GDPR-inspired).
//
// `nextSendAt` is computed after each send (or each cron run if no send
// happened) to tomorrow's preferredTime. The cron job queries subscriptions
// where `nextSendAt <= now()` AND `enabled = true` AND `unsubscribedAt IS NULL`.
// ---------------------------------------------------------------------------

model Subscription {
  id              String    @id @default(cuid())
  farmerId        String    @unique
  farmer          Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(true)
  preferredTime   String    @default("06:00")  // "HH:MM" 24h, Africa/Algiers
  consentedAt     DateTime  @default(now())
  consentIp       String?
  consentVersion  String    @default("1.0")    // privacy policy version
  unsubscribedAt  DateTime?
  unsubscribeReason String?                    // "user_replied_stop" | "user_clicked_link" | "manual"
  nextSendAt      DateTime?                    // null until first consent processed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, nextSendAt])
  @@index([unsubscribedAt])
}

// ---------------------------------------------------------------------------
// BriefLog — append-only audit log of every brief we attempted to send
//
// One row per (farmer, day). Even in Foundation mode (stub send), we log
// every brief that WOULD have been sent — this lets us:
//   1. Verify the pipeline works end-to-end before going live
//   2. Show farmers "here's what you would have received" in the UI
//   3. Have a complete audit trail from day 1
//
// Status flow: PENDING → SENT → DELIVERED → READ  (or FAILED at any step)
// ---------------------------------------------------------------------------

model BriefLog {
  id              String      @id @default(cuid())
  farmerId        String
  farmer          Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  sentAt          DateTime    @default(now())
  messageId       String?     // Meta's message ID (null in stub mode)
  status          BriefStatus @default(PENDING)
  sendMode        SendMode    @default(STUB)  // STUB | LIVE — what mode we were in when we tried
  errorMessage    String?
  briefPreview    String      // First 200 chars, for debugging + "view past briefs" UI
  briefLength     Int
  weatherSource   String      @default("open-meteo")  // "open-meteo" | "atlas_default"
  language        Language    @default(AR)

  @@index([farmerId, sentAt])
  @@index([status])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// ProSubscription — paid tier via Chargily (CIB + Edahabia)
//
// One subscription per farmer. When `status=ACTIVE` and `expiresAt > now()`,
// the farmer has Pro access. Checked by the isProFarmer() helper.
//
// Foundation mode: no Chargily key configured → checkout returns a stub URL.
// When CHARGILY_SECRET_KEY is set, real checkout sessions are created.
// ---------------------------------------------------------------------------

model ProSubscription {
  id              String          @id @default(cuid())
  farmerId        String          @unique
  farmer          Farmer          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  status          ProStatus       @default(PENDING)
  plan            String          @default("pro_monthly")  // "pro_monthly" | "pro_annual" | "coop_monthly"
  amountDzd       Int             // amount charged in DZD (not centimes)
  checkoutId      String?         // Chargily checkout session ID
  checkoutUrl     String?         // Chargily checkout URL (stored for debugging)
  paidAt          DateTime?
  expiresAt       DateTime?       // null = no expiry (coop annual)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([farmerId, status])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Language {
  EN
  FR
  AR
}

enum BriefStatus {
  PENDING    // brief was computed, not yet handed off to WhatsApp client
  SENT       // WhatsApp client accepted it (stub mode: always SENT immediately)
  DELIVERED  // Meta confirmed delivery to handset (live mode only)
  READ       // Farmer opened WhatsApp (live mode only)
  FAILED     // send failed — see errorMessage
  SKIPPED    // brief was skipped (e.g., farmer has no crop set)
}

enum SendMode {
  STUB  // WHATSAPP_SEND_MODE=stub — log to BriefLog, don't actually send
  LIVE  // WHATSAPP_SEND_MODE=live — real WhatsApp Business Cloud API send
}

enum ProStatus {
  PENDING   // checkout created, not yet paid
  ACTIVE    // paid, Pro access active
  EXPIRED   // past expiresAt
  CANCELLED // cancelled by user or failed payment
}
